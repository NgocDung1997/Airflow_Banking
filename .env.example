# Template for .env — copy it and fill in your own values:
#   Copy-Item .env.example .env
# Never commit .env.

# ── Airflow containers ────────────────────────────────────────────────────────
# User id the Airflow processes run as (group 0). 50000 = the default user of the official image.
AIRFLOW_UID=50000

# ── Metadata database (container airflow-postgres-dungafk, no host port) ──────
# Read only on the FIRST start of the empty volume airflow_postgres_data.
# Must NOT start with "pg_" (reserved by Postgres).
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow_db

# ── Web UI login (http://localhost:8090), created by airflow-init-dungafk ─────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# ── Airflow secrets ───────────────────────────────────────────────────────────
# Fernet key encrypts connection passwords / variables in the metadata DB. Changing it makes them unreadable.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change-me
# Signs the tokens tasks use to talk to the API server (same value in every container)
AIRFLOW_JWT_SECRET=change-me
# Signs UI session cookies
AIRFLOW_API_SECRET_KEY=change-me

# ── Flag store (dags/common/flags.py) ─────────────────────────────────────────
# Database on airflow-postgres-dungafk (same login as AIRFLOW_DB_*), created by airflow-init-dungafk.
# Tables job_flag (one row per table + cob_dt) and job_flag_history.
ETL_CONTROL_DB_NAME=etl_control

# ── LakeHouse_Banking (Spark) ─────────────────────────────────────────────────
# Container that runs spark-submit (client mode); tasks call: docker exec <it> spark-submit <job>
SPARK_CLIENT_CONTAINER=spark-client-dungafk
# Path of LakeHouse_Banking/jobs INSIDE that container
LAKEHOUSE_JOBS_ROOT=/home/spark/jobs
# Airflow pool that limits how many Spark jobs run at the same time
SPARK_POOL=spark_jobs
SPARK_POOL_SLOTS=2

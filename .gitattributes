# Force LF line endings: dags/ and docker/ are mounted / copied into Linux containers,
# where a stray \r breaks parsing.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch
*.png binary
*.jpg binary
*.xlsx binary
